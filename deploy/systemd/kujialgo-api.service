[Unit]
Description=Koju Dhan Algo FastAPI Dashboard Service
After=network-online.target
Wants=network-online.target

[Service]
User=koju
Group=koju
WorkingDirectory=/opt/kujialgo
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/kujialgo/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
